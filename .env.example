# Discord Botのトークン（Discord Developer Portalで発行）
DISCORD_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Botを動作させるDiscordサーバー（ギルド）のID
GUILD_ID=xxxxxxxxxxxxxxxxxxx
# 通知を送信するDiscordチャンネルのID
NOTIFY_CHANNEL_ID=xxxxxxxxxxxxxxxxxxx

# ログレベル（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
# ログファイルの保存日数（これより古い logs/*.log は自動削除される）
LOG_RETENTION_DAYS=30

# 配信状態のポーリング間隔（秒）
POLL_INTERVAL_SECONDS=60
# ライブ中のポーリング間隔（秒）
LIVE_POLL_INTERVAL_SECONDS=60
# ポーリング間隔のランダムな揺らぎ比率（0.1 = ±10%）
POLL_JITTER_RATIO=0.1
# 通信エラー時の最大バックオフ秒数
MAX_BACKOFF_SECONDS=600
# ポーリングスケジューラの実行間隔（秒）
SCHEDULER_TICK_SECONDS=5
# 配信者を1人ずつ処理する際のリクエスト間隔（秒）の範囲
MIN_REQUEST_GAP_SECONDS=0.5
MAX_REQUEST_GAP_SECONDS=2.0
# 配信者選択パネルのタイムアウト秒数
PANEL_VIEW_TIMEOUT_SECONDS=120
